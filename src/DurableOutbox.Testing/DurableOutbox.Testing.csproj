<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>The DurableOutbox contract tests, to run against your own DbContext and schema from any test framework, and RunUntilIdleAsync for your integration tests.</Description>
    <PackageTags>$(PackageTags);testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DurableOutbox\DurableOutbox.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DurableOutbox.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The kit uses the library's internals, so it must be installed with exactly the same version of it.
    NuGet packs a project reference as ">= version"; this makes it "[version]".
  -->
  <Target Name="PinDurableOutboxVersion" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>
</Project>
