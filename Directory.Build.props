<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Package metadata. Projects that ship set IsPackable; nothing else packs. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The release version. A prerelease adds a label at pack time: -p:VersionSuffix=rc.1 gives 1.0.0-rc.1. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Tosin Shada</Authors>
    <Copyright>Copyright (c) 2026 Tosin Shada</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>outbox;transactional-outbox;postgresql;efcore;npgsql</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RepositoryUrl>https://github.com/tosinshada/durable-outbox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/tosinshada/durable-outbox</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
